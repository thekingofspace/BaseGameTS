{
	"name": "BaseGame",
	"globIgnorePaths": [
		"**/package.json",
		"**/tsconfig.json",
		"**/*.d.ts"
	],
	"tree": {
		"$className": "DataModel",

		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"Shared": {
				"$path": "Modules/Shared"
			},
			"PrimaryGame": {
				"$path": "out/PrimaryGame"
			},
			"rbxts_include": {
				"$path": "include",
				"node_modules": {
					"$className": "Folder",
					"@rbxts": {
						"$path": "node_modules/@rbxts"
					}
				}
			}
		},

		"ServerStorage": {
			"$className": "ServerStorage",
			"ServerModules": {
				"$path": "Modules/Server"
			}
		},

		"ServerScriptService": {
			"$className": "ServerScriptService",
			"Server": {
				"$path": "out/server"
			}
		},

		"StarterPlayer": {
			"$className": "StarterPlayer",
			"StarterPlayerScripts": {
				"$className": "StarterPlayerScripts",
				"Client": {
					"$path": "out/client"
				}
			}
		},

		"Workspace": {
			"$className": "Workspace",
			"$properties": {
				"FilteringEnabled": true
			}
		},

		"HttpService": {
			"$className": "HttpService",
			"$properties": {
				"HttpEnabled": true
			}
		},

		"SoundService": {
			"$className": "SoundService",
			"$properties": {
				"RespectFilteringEnabled": true
			}
		}
	}
}
